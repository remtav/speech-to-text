<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurfaceContainer"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/model"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:contentDescription="@string/cd_model"
            android:text="Parakeet" />

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:drawablePadding="6dp"
            android:textAppearance="@style/TextAppearance.Dictee.Value"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_wait"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/cancel"
            android:contentDescription="@string/cd_cancel_wait"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/help"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_help"
            android:src="@drawable/ic_help" />

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            android:src="@drawable/ic_tune" />
    </LinearLayout>

    <io.github.remtav.dictee.ime.LevelMeterView
        android:id="@+id/level"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mic"
        style="@style/Widget.Dictee.Button.Mic"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@string/cd_start"
        app:icon="@drawable/ic_mic" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_switch"
            style="@style/KeyButton"
            android:contentDescription="@string/cd_switch"
            app:icon="@drawable/ic_keyboard" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_comma"
            style="@style/KeyButton"
            android:text="," />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_period"
            style="@style/KeyButton"
            android:text="." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_space"
            style="@style/KeyButton"
            android:layout_weight="2.4"
            android:contentDescription="@string/cd_space"
            app:icon="@drawable/ic_space" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_question"
            style="@style/KeyButton"
            android:text="\?" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_exclaim"
            style="@style/KeyButton"
            android:text="!" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_backspace"
            style="@style/KeyButton"
            android:layout_weight="1.3"
            android:contentDescription="@string/cd_backspace"
            app:icon="@drawable/ic_backspace" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_enter"
            style="@style/KeyButton"
            android:layout_weight="1.3"
            android:contentDescription="@string/cd_enter"
            app:icon="@drawable/ic_enter" />
    </LinearLayout>
</LinearLayout>
