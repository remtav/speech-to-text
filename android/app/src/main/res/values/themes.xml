<?xml version="1.0" encoding="utf-8"?>
<!--
  Thème générique Material 3 (clair et sombre, DayNight), polices du système, formes et ombres par
  défaut de Material. Les couleurs viennent de colors.xml (clair) et values-night/colors.xml (sombre) :
  ce fichier ne contient aucune valeur de couleur, seulement la correspondance « couleur -> rôle
  Material 3 », avec tous les rôles utilisés par un composant, pour qu'aucun ne retombe sur la
  palette violette par défaut en thème sombre. Le test ThemeContrastTest relit ce fichier.
-->
<resources>
    <style name="Theme.Dictee" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryInverse">@color/md_inverse_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorSurfaceInverse">@color/md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_inverse_on_surface</item>
        <item name="colorSurfaceDim">@color/md_surface_dim</item>
        <item name="colorSurfaceBright">@color/md_surface_bright</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>

        <!-- Couleurs de texte du cadre Android : sans elles, tout TextView, case à cocher ou bouton
             radio sans couleur explicite prendrait la couleur de texte de la palette Material par
             défaut, incohérente avec les surfaces ci-dessus. Elles renvoient aux rôles (res/color). -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorTertiary">@color/text_secondary</item>
        <item name="android:textColorPrimaryDisableOnly">@color/text_primary</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textColorHighlight">@color/text_highlight</item>
        <item name="android:textColorPrimaryInverse">@color/md_inverse_on_surface</item>
        <item name="android:textColorSecondaryInverse">@color/md_inverse_on_surface</item>
        <item name="android:textColorTertiaryInverse">@color/md_inverse_on_surface</item>
        <item name="android:textColorPrimaryInverseDisableOnly">@color/md_inverse_on_surface</item>
        <item name="android:textColorHintInverse">@color/md_inverse_on_surface</item>
        <item name="android:textColorHighlightInverse">@color/md_inverse_primary</item>

        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
    </style>

    <!-- Le clavier se thème comme l'application ; la nuit est choisie par le service (voir DicteeImeService). -->
    <style name="Theme.Dictee.Keyboard" parent="Theme.Dictee"/>

    <!-- ===== Styles de texte nommés (apparences Material par défaut, polices du système) ===== -->
    <style name="TextAppearance.Dictee.Headline" parent="TextAppearance.Material3.HeadlineSmall"/>
    <style name="TextAppearance.Dictee.Title" parent="TextAppearance.Material3.TitleMedium"/>
    <style name="TextAppearance.Dictee.Body" parent="TextAppearance.Material3.BodyMedium"/>
    <style name="TextAppearance.Dictee.BodySmall" parent="TextAppearance.Material3.BodySmall"/>
    <!-- Étiquette : petit texte secondaire (la couleur est posée par l'appelant). -->
    <style name="TextAppearance.Dictee.Label" parent="TextAppearance.Material3.LabelMedium"/>
    <!-- Valeur technique : taille d'un modèle, score, état du clavier. -->
    <style name="TextAppearance.Dictee.Value" parent="TextAppearance.Material3.BodyMedium"/>
    <!-- Texte à lire à voix haute (test de lecture) : grand ; l'interligne est posé dans le code. -->
    <style name="TextAppearance.Dictee.Reading" parent="TextAppearance.Material3.TitleLarge"/>
    <!-- Symbole d'une touche du clavier : 24 sp (lisibilité d'abord, 20 sp au minimum). -->
    <style name="TextAppearance.Dictee.Key" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">24sp</item>
    </style>

    <!-- ===== Composants ===== -->
    <!-- Micro du clavier : bouton rond ; couleur d'erreur (rouge) quand la vue est activée (écoute). -->
    <style name="Widget.Dictee.Button.Mic" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/mic_bg</item>
        <item name="iconTint">@color/mic_icon</item>
        <item name="cornerRadius">50dp</item>
        <item name="iconSize">44dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
    </style>
    <!-- Touche du clavier : bouton tonal, coins de 12 dp, symbole de 24 sp, 52 dp de haut.
         L'écart entre deux touches est une marge interne (insetLeft/insetRight), pas une marge externe :
         la zone tactile couvre ainsi toute la largeur de la case, écart compris. -->
    <style name="KeyButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:insetLeft">3dp</item>
        <item name="android:insetRight">3dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Dictee.Key</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">24dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>
